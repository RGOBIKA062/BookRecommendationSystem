# Example Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Server Configuration
PORT=5001

# Database Configuration
MONGO_URI=mongodb://localhost:27017/bookrecommendation
# For production with MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bookrecommendation

# Authentication Secret (Use a strong random string in production)
JWT_SECRET=supersecretkey

# AI API Keys - Get these from your respective providers
# GROQ Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI Platform: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here